# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Strong random secret for signing stream URLs
STREAM_SECRET=change-me-to-a-long-random-string

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Cast service
CAST_SERVICE_URL=http://localhost:4000

# === Cast Service (cast-service/.env) ===
# API_ID=       # from my.telegram.org
# API_HASH=
# SESSION_STRING=   # preferred (generate once)
# SESSION_NAME=music_cast
