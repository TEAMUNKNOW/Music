# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Strong random secret for signing stream URLs
STREAM_SECRET=change-me-to-a-long-random-string

# Railway Redis: add a Redis service and reference its REDIS_URL
REDIS_URL=redis://localhost:6379

# Railway automatically provides RAILWAY_PUBLIC_DOMAIN after you generate a domain.
# BASE_URL can be left unset in Railway; the backend will use that domain automatically.
BASE_URL=
PORT=3000

# Optional Piped API override
PIPED_API_URL=https://pipedapi.kavin.rocks

# Optional VC cast service
CAST_SERVICE_URL=http://localhost:4000

# Optional VC credentials — leave all unset to keep VC Cast OFF.
# API_ID=
# API_HASH=
# SESSION_STRING=
# SESSION_NAME=music_cast

# Optional frontend override. Leave unset for same-origin unified deployment.
# VITE_API_BASE=
