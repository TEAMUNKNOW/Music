# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Strong random secret for signing stream URLs
STREAM_SECRET=change-me-to-a-long-random-string

# Redis (Railway can provide this as REDIS_URL)
REDIS_URL=redis://localhost:6379

# Backend
PORT=3000
BASE_URL=http://localhost:3000

# Piped API (optional; official public instance is the default)
PIPED_API_URL=https://pipedapi.kavin.rocks

# Optional VC cast service
CAST_SERVICE_URL=http://localhost:4000

# === Cast Service: leave unset to keep VC Cast OFF ===
# API_ID=
# API_HASH=
# SESSION_STRING=
# SESSION_NAME=music_cast

# === Frontend build variable ===
# VITE_API_BASE=https://your-backend.up.railway.app
